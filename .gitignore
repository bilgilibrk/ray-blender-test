# Build output
build/

# Third-party downloads. vendor/raylib is a submodule and is tracked;
# everything else here is fetched or generated.
vendor/raylib-build/
vendor/*.zip

# Blender's rolling backup of the .blend
*.blend1

# Screenshots dropped by F2 or --shots
shot-*.png
*.png.tmp

# Python bytecode from the Blender tools
__pycache__/
*.pyc
